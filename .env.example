DATABASE_URL=postgresql+asyncpg://cms:cms@localhost:5432/catechism_management_system

LOGTO_ENDPOINT=https://<tenant-id>.logto.app
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_REDIRECT_URI=http://localhost:3000/auth/callback
LOGTO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
LOGTO_SCOPES=openid profile email offline_access custom_data

SESSION_ENCRYPTION_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating: put the new key first, then old keys comma-separated (MultiFernet order).
SESSION_COOKIE_NAME=cms_session
# Production: use "__Host-cms_session" (requires Secure, Path=/, no Domain).
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=1209600
