{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git *": "deny",
      "rm *": "deny",
      "mv *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "grep": {
      "**/.env*": "deny",
      "**/.env.example": "allow"
    },
    "glob": {
      "**/.env*": "deny",
      "**/.env.example": "allow"
    }
  }
}