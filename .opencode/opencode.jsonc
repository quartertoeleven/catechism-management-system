{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nuxt": {
      "type": "remote",
      "url": "https://nuxt.com/mcp",
      "enabled": true
    },
    "nuxt-ui": {
      "type": "remote",
      "url": "https://ui.nuxt.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "git *": "deny",
      "rm *": "deny",
      "mv *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "grep": {
      "**/.env*": "deny",
      "**/.env.example": "allow"
    },
    "glob": {
      "**/.env*": "deny",
      "**/.env.example": "allow"
    }
  }
}