    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start CMS Admin Dashboard API - Debug",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}/apps/cms_admin_dashboard_api",
            "module": "uvicorn",
            "args": [
                "main:create_app",
                "--factory",
                "--reload"
            ]
        }
    ]
}