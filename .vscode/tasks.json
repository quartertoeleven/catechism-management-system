{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start CMS Admin Dashboard API - Dev",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "--directory",
                "apps/cms_admin_dashboard_api",
                "uvicorn",
                "main:create_app",
                "--factory",
                "--reload"
            ],
            "options": {
                "shell": {
                    "args": [
                        "-l",
                        "-ic"
                    ]
                }
            }
        }
    ]
}